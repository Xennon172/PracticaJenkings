// ──────────────────────────────────────────────────
//  JOB 4 – Tests Mocha + notificación de resultados
//  Disparado con cada push al repositorio (Webhook)
// ──────────────────────────────────────────────────
pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    triggers {
        githubPush()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Instalar dependencias') {
            steps {
                dir('code') {
                    sh 'npm install'
                }
            }
        }

        stage('Pasar tests') {
            steps {
                dir('code') {
                    sh 'npm test'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'code/test-results/results.xml'
                }
            }
        }
    }

    post {
        success {
            echo '✅ Todos los tests han pasado correctamente.'
        }
        failure {
            echo '❌ Algún test ha fallado. Revisa los logs.'
        }
    }
}
