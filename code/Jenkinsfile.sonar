// ──────────────────────────────────────────────────
//  JOB 5 – Escaneo SonarQube
//  Disparado con cada push al repositorio (Webhook)
// ──────────────────────────────────────────────────
pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    triggers {
        githubPush()
    }

    environment {
        // Nombre exacto del servidor configurado en:
        // Manage Jenkins → Configure System → SonarQube servers
        SONAR_SERVER = 'SonarQube'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Instalar dependencias') {
            steps {
                sh 'npm install'
            }
        }

        stage('Análisis SonarQube') {
            steps {
                // withSonarQubeEnv inyecta automáticamente las variables
                // SONAR_HOST_URL y SONAR_AUTH_TOKEN
                withSonarQubeEnv("${SONAR_SERVER}") {
                    // sonar-scanner usa sonar-project.properties de la raíz
                    sh 'sonar-scanner'
                }
            }
        }

        stage('Quality Gate') {
            steps {
                // Espera el resultado del Quality Gate en SonarQube
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        success {
            echo '✅ Análisis SonarQube completado. Quality Gate superado.'
        }
        failure {
            echo '❌ Quality Gate NO superado. Revisa SonarQube en http://localhost:9000'
        }
    }
}
