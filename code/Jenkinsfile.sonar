pipeline {
    agent any

    tools {
        nodejs 'NodeJS'
    }

    triggers {
        githubPush()
    }

    environment {
        SONAR_SERVER = 'SonarQube'
        SONAR_TOKEN = credentials('sonarqube-token')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Instalar dependencias') {
            steps {
                dir('code') {
                    sh 'npm install'
                }
            }
        }

        stage('Analisis SonarQube') {
            steps {
                dir('code') {
                    withSonarQubeEnv("${SONAR_SERVER}") {
                        sh "sonar-scanner -Dsonar.token=${SONAR_TOKEN}"
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        success {
            echo 'EXITO: Analisis SonarQube completado. Quality Gate superado.'
        }
        failure {
            echo 'FALLO: Quality Gate NO superado. Revisa SonarQube en http://localhost:9000'
        }
    }
}
